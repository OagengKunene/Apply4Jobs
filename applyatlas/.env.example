# No API key is needed for the deterministic demo.
APPLYATLAS_DATA_DIR=./data
APPLYATLAS_PORT=8000
# Live submissions are disabled unless deliberately enabled.
APPLYATLAS_LIVE_SUBMIT=false
# Optional: semantic evidence selection through an OpenAI-compatible endpoint.
# Only evidence facts/skills and job text go to this provider, never contact fields.
APPLYATLAS_LLM_BASE_URL=https://api.openai.com/v1
APPLYATLAS_LLM_API_KEY=
APPLYATLAS_LLM_MODEL=
# Optional stable owner API token. Otherwise generated into data/owner-token.txt.
APPLYATLAS_API_TOKEN=
# Optional fallback if Playwright browser downloads are unavailable:
# APPLYATLAS_BROWSER_EXECUTABLE=/usr/bin/chromium
